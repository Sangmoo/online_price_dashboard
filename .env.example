# 이 파일을 복사해 .env 를 만들고 실제 값을 입력하세요. (.env 는 git 에 올라가지 않습니다)

# Oracle Instant Client 경로 (Thick 모드용)
ORACLE_CLIENT_PATH=C:\oracle\instantclient_23_7

# ORACLE 11g DB 접속 정보
DB_HOST=
DB_PORT=1521
DB_SID=
DB_USER=
# 특수문자($ 등)가 있으면 작은따옴표로 감싸세요 (dotenv 변수 확장 방지)
DB_PASSWORD=''

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# 업무 테이블 소유 스키마 (시노님이 없는 객체 접근용)
DB_OWNER_SCHEMA=SS10

# 최고 관리자 ID (항상 ADMIN, 권한 변경/비활성화 불가)
SUPER_ADMIN_ID=250016
# HTTPS 로 서비스할 때만 true (세션 쿠키 Secure 속성)
COOKIE_SECURE=false

# 백엔드 포트 / 프론트 허용 Origin
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
